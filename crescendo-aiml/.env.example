# Groq API key (Required for LangGraph workflow generation)
GROQ_API_KEY=your_groq_api_key_here

# Shared Service Token (Must match crescendo.python-ai.service-token in Java backend)
SERVICE_TOKEN=your_shared_secret_here

# Backend URL Routing (If using cloud tunnels instead of Docker network)
# For local tunnels: JAVA_BACKEND_URL=https://api.crescendo.run/internal/catalog
# For Docker internal: JAVA_BACKEND_URL=http://crescendo-backend:8080/internal/catalog
JAVA_BACKEND_URL=https://api.crescendo.run/internal/catalog

# Redis Connection (If running Python outside of Docker)
REDIS_URL=redis://localhost:6379/1
