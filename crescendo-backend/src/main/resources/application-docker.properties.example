# ==============================================================================
# Docker & Production Environment Profile Template
# ==============================================================================
# This profile is active inside containerized environments (SPRING_PROFILES_ACTIVE=docker,prod).
# It binds to container network DNS aliases and enforces production sizing and security defaults.

# ── Command Database (Write Side) - CQRS ──────────────────────────────────────
spring.datasource.command.url=jdbc:postgresql://${POSTGRES_HOST:postgres}:${POSTGRES_PORT:5432}/${POSTGRES_COMMAND_DB:crescendo_command}
spring.datasource.command.username=${POSTGRES_USER:crescendo_user}
spring.datasource.command.password=${POSTGRES_PASSWORD:}
spring.datasource.command.driver-class-name=org.postgresql.Driver
# Right-sized for 2 vCPU / 4 GiB RAM host: 8 connections per pool (~160 MiB total in Postgres)
spring.datasource.command.hikari.maximum-pool-size=8
spring.datasource.command.hikari.minimum-idle=2
spring.datasource.command.hikari.connection-timeout=20000
spring.datasource.command.hikari.idle-timeout=300000
spring.datasource.command.hikari.max-lifetime=1200000

# ── Query Database (Read Side) - CQRS ─────────────────────────────────────────
spring.datasource.query.url=jdbc:postgresql://${POSTGRES_HOST:postgres}:${POSTGRES_PORT:5432}/${POSTGRES_QUERY_DB:crescendo_query}
spring.datasource.query.username=${POSTGRES_USER:crescendo_user}
spring.datasource.query.password=${POSTGRES_PASSWORD:}
spring.datasource.query.driver-class-name=org.postgresql.Driver
spring.datasource.query.hikari.maximum-pool-size=8
spring.datasource.query.hikari.minimum-idle=2
spring.datasource.query.hikari.connection-timeout=20000
spring.datasource.query.hikari.idle-timeout=300000
spring.datasource.query.hikari.max-lifetime=1200000

# ── Docker & Production Environment Settings ──────────────────────────────────
spring.jpa.show-sql=false
logging.level.org.springframework.web=INFO

# ── Redis (Docker internal network container DNS alias) ────────────────────────
spring.data.redis.host=${REDIS_HOST:crescendo-redis}
spring.data.redis.port=${REDIS_PORT:6379}
spring.data.redis.password=${REDIS_PASSWORD:}
spring.data.redis.timeout=5000
spring.data.redis.connect-timeout=3000

# ── Reverse Proxy & Cloudflare Tunnel Trust ────────────────────────────────────
app.security.trust-forwarded-headers=${APP_SECURITY_TRUST_FORWARDED_HEADERS:true}

# ── Cookie Security (Cross-Subdomain app.crescendo.run -> api.crescendo.run) ──
app.cookie.secure=${APP_COOKIE_SECURE:true}
app.cookie.domain=${APP_COOKIE_DOMAIN:crescendo.run}
app.cookie.same-site=${APP_COOKIE_SAME_SITE:Lax}

# ── Internal AI Microservice Direct Routing ───────────────────────────────────
crescendo.python-ai.base-url=${CRESCENDO_PYTHON_AI_BASE_URL:http://crescendo-aiml:8000}
crescendo.python-ai.service-token=${SERVICE_TOKEN:}

# ── Persistent Storage (AWS S3 or S3-compatible R2/MinIO via endpoint override) 
crescendo.storage.s3.bucket=${S3_BUCKET_NAME:crescendo-platform-storage}
crescendo.storage.s3.region=${AWS_REGION:us-east-1}
crescendo.storage.s3.access-key=${AWS_ACCESS_KEY_ID:}
crescendo.storage.s3.secret-key=${AWS_SECRET_ACCESS_KEY:}
crescendo.storage.s3.endpoint=${S3_ENDPOINT_OVERRIDE:}

# ── Transactional Email Provider ──────────────────────────────────────────────
crescendo.email.provider=${CRESCENDO_EMAIL_PROVIDER:brevo}
brevo.api.key=${BREVO_API_KEY:}
