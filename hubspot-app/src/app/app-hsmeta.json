{
  "uid": "crescendo_oauth_app_app",
  "type": "app",
  "config": {
    "description": "Crescendo integration for HubSpot CRM, contacts, deals, companies, tickets, and forms.",
    "name": "Crescendo",
    "distribution": "marketplace",
    "auth": {
      "type": "oauth",
      "redirectUrls": [
        "https://api.crescendo.run/connections/oauth/hubspot/callback",
        "http://localhost:5173/connections/oauth/hubspot/callback"
      ],
      "requiredScopes": [
        "oauth",
        "crm.objects.contacts.read",
        "crm.objects.contacts.write",
        "crm.objects.companies.read",
        "crm.objects.companies.write",
        "crm.objects.deals.read",
        "crm.objects.deals.write",
        "crm.objects.owners.read",
        "crm.schemas.contacts.read",
        "crm.schemas.companies.read",
        "crm.schemas.deals.read",
        "crm.lists.write",
        "forms",
        "crm.objects.tickets.read",
        "crm.objects.tickets.write",
        "crm.schemas.tickets.read",
        "crm.schemas.tickets.write"
      ],
      "optionalScopes": [],
      "conditionallyRequiredScopes": []
    },
    "permittedUrls": {
      "fetch": [
        "https://api.hubapi.com"
      ],
      "iframe": [],
      "img": []
    },
    "support": {
      "supportEmail": "support@example.com",
      "documentationUrl": "https://example.com/docs",
      "supportUrl": "https://example.com/support",
      "supportPhone": "+18005555555"
    }
  }
}