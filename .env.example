# ==============================================================================
# Crescendo Automation Engine - Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env on your server and populate with real production secrets.
# NEVER commit .env to version control (.env is excluded in .gitignore).

# ------------------------------------------------------------------------------
# 1. Host & Domain Routing
# ------------------------------------------------------------------------------
APP_FRONTEND_URL=https://app.crescendo.run
APP_BACKEND_URL=https://api.crescendo.run
APP_PUBLIC_API_ISSUER=https://api.crescendo.run
APP_SECURITY_TRUST_FORWARDED_HEADERS=true
APP_COOKIE_DOMAIN=crescendo.run
APP_COOKIE_SECURE=true
APP_COOKIE_SAME_SITE=Lax
APP_CORS_ALLOWED_ORIGINS=https://app.crescendo.run

# Cloudflare Tunnel Token (from Cloudflare Zero Trust Dashboard -> Tunnels)
TUNNEL_TOKEN=

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=AnkitArsh
POSTGRES_PASSWORD=
POSTGRES_COMMAND_DB=crescendo_command
POSTGRES_QUERY_DB=crescendo_query

# ------------------------------------------------------------------------------
# 3. Redis 8 Cache & Event Streams
# ------------------------------------------------------------------------------
REDIS_HOST=crescendo-redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://crescendo-redis:6379/1

# ------------------------------------------------------------------------------
# 4. Security & Cryptography Keys
# ------------------------------------------------------------------------------
# 256-bit Base64-encoded key for encrypting stored OAuth connection credentials
# Generate via PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object {Get-Random -Maximum 256}))
CREDENTIALS_CRYPTO_KEY=

# JWT Secret for access token signing (HMAC-SHA256)
JWT_SECRET=

# ------------------------------------------------------------------------------
# 5. Internal Microservice Communication
# ------------------------------------------------------------------------------
# Shared Bearer token authenticating internal calls from Java backend to Python AI service
SERVICE_TOKEN=
CRESCENDO_PYTHON_AI_BASE_URL=http://crescendo-aiml:8000
JAVA_BACKEND_URL=http://crescendo-backend:8080/internal/catalog

# ------------------------------------------------------------------------------
# 6. AI Microservice LLM Providers & Bot Services
# ------------------------------------------------------------------------------
GROQ_API_KEY=
GEMINI_API_KEY=
SARVAM_API_KEY=
TELEGRAM_BOT_TOKEN=

# ------------------------------------------------------------------------------
# 7. Persistent Object Storage (AWS S3 or S3-Compatible: R2, MinIO, Wasabi)
# ------------------------------------------------------------------------------
S3_BUCKET_NAME=crescendo-platform-storage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Leave empty for standard AWS S3. For Cloudflare R2: https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT_OVERRIDE=

# ------------------------------------------------------------------------------
# 8. Email Service (Transactional Notifications)
# ------------------------------------------------------------------------------
CRESCENDO_EMAIL_PROVIDER=brevo
BREVO_API_KEY=

# ------------------------------------------------------------------------------
# 9. GeoIP & Threat Detection (MaxMind GeoLite2)
# ------------------------------------------------------------------------------
MAXMIND_LICENSE_KEY=

# ------------------------------------------------------------------------------
# 10. Core OAuth2 Login Providers
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 11. Third-Party Integration OAuth Providers (Automation Connectors)
# ------------------------------------------------------------------------------
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=
GOOGLE_DRIVE_CLIENT_ID=
